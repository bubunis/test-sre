# Pinned chart versions (same locally and in CI). Bump them on purpose, one at a time.
# Grafana's Loki and Tempo charts moved to the grafana-community repo; the
# old grafana/loki and grafana/tempo charts no longer get releases.
KPS_REPO=https://prometheus-community.github.io/helm-charts
KPS_VERSION=87.19.0            # kube-prometheus-stack: Prometheus, Alertmanager, Grafana, operator

GRAFANA_COMMUNITY_REPO=https://grafana-community.github.io/helm-charts
LOKI_VERSION=21.1.0            # Loki, monolithic mode
TEMPO_VERSION=1.26.4           # Tempo, single binary

OTEL_REPO=https://open-telemetry.github.io/opentelemetry-helm-charts
OTEL_COLLECTOR_VERSION=0.180.0 # OpenTelemetry collector
