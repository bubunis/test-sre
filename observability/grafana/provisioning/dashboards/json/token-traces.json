{
  "uid": "token-traces",
  "title": "Token Service \u00b7 Traces",
  "description": "Find slow, failed or specific requests and open the full trace (API -> gRPC -> Redis).",
  "tags": [
    "token-service",
    "traces"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "Token Service dashboards",
      "type": "dashboards",
      "tags": [
        "token-service"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Test scenarios",
        "target": {
          "type": "tags",
          "tags": [
            "scenario"
          ],
          "matchAny": true,
          "limit": 100
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "client",
        "label": "Client id",
        "type": "textbox",
        "query": "login-service",
        "current": {
          "text": "login-service",
          "value": "login-service"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "How to use",
      "options": {
        "mode": "markdown",
        "content": "Click a **Trace ID** to open the trace. From a span, **Logs for this span** opens the matching log lines in Loki. Change *Client id* above to see one caller's requests."
      },
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "table",
      "title": "Slow requests (> 250 ms)",
      "description": "API requests that took longer than 250 ms end to end.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"python-token-service\" && kind = server && duration > 250ms }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 2,
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 3
      }
    },
    {
      "type": "table",
      "title": "Failed requests",
      "description": "Any span marked as error: database, gRPC or Redis failures.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ status = error }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 3,
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 3
      }
    },
    {
      "type": "table",
      "title": "Requests from client $client",
      "description": "Requests whose JWT named this client.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ span.app.client_id = \"$client\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 4,
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "table",
      "title": "Token mints (Go service)",
      "description": "gRPC MintToken calls handled by the Go service.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"go-token-service\" && kind = server }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 5,
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 14
      }
    }
  ]
}
