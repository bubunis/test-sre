        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(http_requests_total{handler=\"/token\",status=\"4xx\"}[$__rate_interval])) or vector(0)) / sum(rate(http_requests_total{handler=\"/token\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
